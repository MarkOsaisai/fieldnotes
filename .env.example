# JWT Configuration (required)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Server Port (optional, Vercel sets this automatically)
PORT=3000

# Database Configuration
# For local development (SQLite): leave DATABASE_URL unset
# For production (PostgreSQL): set DATABASE_URL to your PostgreSQL connection string
# Example PostgreSQL URLs:
#   postgresql://user:password@localhost:5432/fieldnotes
#   postgresql://user:password@neon.tech/fieldnotes
# DATABASE_URL=

# Optional: Custom SQLite database path (only used if DATABASE_URL is not set)
# Defaults to: server/data/fieldnotes.db
# FIELDNOTES_DB_PATH=/path/to/database.db

# Cloudinary Configuration (optional but recommended for production)
# If set, uploads will be stored on Cloudinary instead of local filesystem.
# Get these from: https://cloudinary.com/console/settings/api
# If not set, uploads will be stored locally (not persistent on Vercel).
# 
# Option 1: Use CLOUDINARY_URL
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
#
# Option 2: Use individual variables
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# For local development only: force local storage even if Cloudinary is not configured
# USE_LOCAL_STORAGE=true


